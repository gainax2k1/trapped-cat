[sub_resource type="Resource" id="Resource_dv8xf"]
script = ExtResource("1_s72sx")
TXT = "Prisoner list:[br]  - Cell 1: 'Baermar' #0036352 [br]  * Bio: (REDACTED) [br]    - Cell 2: 'Artemis' #0036585 [br]  * Bio: (REDACTED) [br]  - Cell 2: 'Neener' #0036788 [br]  * Bio: (REDACTED)   [br] Enroute to: (REDACTED)[br]"
metadata/_custom_type_script = "uid://11r1ksyqtduy"

[sub_resource type="Resource" id="Resource_rfjv2"]
script = ExtResource("1_s72sx")
TXT = "Maintenance Report: [br] Guys, I know we're not exactly a \"legitimate\" prisoner transport, but we can't use the default seurity passcode for everything!  \"1234\" is NOT a good password! [br] I'll keep it simple for you idiots: use the last 4 digits of one of the prisoners in the cell. The computer will automatically updated it when we drop off our \"cargo\". [br] Got it? - Boss"
metadata/_custom_type_script = "uid://11r1ksyqtduy"

[sub_resource type="Resource" id="Resource_s72sx"]
script = ExtResource("1_s72sx")
TXT = "I woke in a daze, smoke in my eyes and lungs. Where was I? [br] WHO was I? [br] ... [br] The sound of alarms surrounded me. [br] The only thing I was sure of: I had to escape."
metadata/_custom_type_script = "uid://11r1ksyqtduy"

[resource]
